# ==========================================
# Cocos Creator: Временные файлы и сборка
# ==========================================
build/
local/
temp/
profiles/
library/

# Логи работы Cocos Creator
native/
*.log

# Автоматически генерируемые декларации TypeScript (создаются движком заново)
@types/
cc.d.ts

# Если используете встроенные js-бэкапы или авто-сгенерированные скрипты расширений
.declarations/

# ==========================================
# Редакторы кода: VS Code
# ==========================================
.vscode/
# Исключение: если вы хотите поделиться настройками отладки (launch.json) с командой,
# раскомментируйте следующие строки, убрав символ '#' перед ними:
#!.vscode/launch.json
#!.vscode/tasks.json

# ==========================================
# Редакторы кода: JetBrains (WebStorm, Rider, IntelliJ IDEA и др.)
# ==========================================
.idea/
*.iws
*.iml
*.ipr

# ==========================================
# Системные файлы и кэш ОС
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# Менеджеры пакетов (если используете кастомные npm-модули)
# ==========================================
node_modules/
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# ==========================================
# Прочие временные файлы
# ==========================================
*.tmp
*.bak
*.swp